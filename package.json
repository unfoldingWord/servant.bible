{
  "name": "servant-bible",
  "version": "0.5.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Servant.Bible: the router Worker, server list, and page for servant.bible",
  "scripts": {
    "generate:version": "node scripts/generate-version.mjs",
    "predev": "node scripts/generate-version.mjs",
    "dev": "wrangler dev",
    "prebuild": "node scripts/generate-version.mjs",
    "build": "wrangler build",
    "version": "node scripts/generate-version.mjs && git add src/generated/version.ts",
    "pretest": "node scripts/generate-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ scripts/",
    "lint:fix": "eslint src/ tests/ scripts/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit && tsc --noEmit --project tests/tsconfig.json",
    "audit:prod": "node scripts/audit-prod.mjs",
    "audit:all": "node scripts/audit-prod.mjs --include-dev --audit-level=high",
    "validate:servers": "node scripts/validate-servers.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": "^22.22.1 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.8",
    "@cloudflare/workers-types": "^5.20261027.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@types/semver": "^7.8.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "semver": "^7.8.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=7.30.1",
      "sharp": ">=0.35.5",
      "zod": ">=4.6.6"
    }
  }
}
